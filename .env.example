# Copiá este archivo como .env y completá con los valores de tu proyecto.
# El .env real NUNCA se sube al repositorio (está en .gitignore).

# Proyecto Supabase. Se sacan de: Supabase → Project Settings → API
# La URL es la base del proyecto, SIN /rest/v1 al final.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=TU_ANON_KEY

# Vite solo expone al navegador las variables con prefijo VITE_.
# Deben tener los mismos valores que las de arriba.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY
